# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopsphere?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=shopsphere_token
# lax works with the Vercel same-origin /api rewrite. Use `none` only when the
# browser calls the Render API directly from a different site (requires HTTPS).
COOKIE_SAME_SITE=lax
# Set to false in production after creating the first administrator.
ALLOW_ADMIN_REGISTRATION=true

# ---------------------------------------------------------------------------
# First administrator (used by `npm run seed:admin`; never commit real values)
# ---------------------------------------------------------------------------
ADMIN_NAME=ShopSphere Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ---------------------------------------------------------------------------
# Cloudinary (product image uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shopsphere/products

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
LOW_STOCK_THRESHOLD=5
