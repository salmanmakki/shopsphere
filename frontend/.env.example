# API base URL used by src/services/api.js
#
# Keep the relative `/api` value in development (Vite proxy) and in production
# (Vercel rewrite to Render). This keeps the httpOnly auth cookie same-origin.
VITE_API_URL=/api

# Show the self-service admin registration page and links.
# Set to `false` on public deployments; create the first admin with the
# backend `npm run seed:admin` script instead.
VITE_ALLOW_ADMIN_REGISTRATION=true
